# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Every value here is a placeholder description, not a real setting.

# --- Where things live on the Mac (outside the repo) ---
EV_DATA_DIR=folder holding tracker_data.json, payments.json, watch_state.json, brief_*.json
EV_CONTRACT_CONTENT_DIR=folder holding contract_final_content.py (contract wording + prices)
EV_SERVED_DIR=folder holding the blank VFinal contract/questionnaire PDF + DOCX
EV_DOCS_DIR=folder where generated contracts and questionnaires are saved
EV_PYTHON=optional: python with python-docx + reportlab (default: ~/.hermes/venvs/ev/bin/python)
EV_PORT=optional: dashboard port (default 8787)

# --- Mail identities ---
EV_ICLOUD_LOGIN=Apple ID address used to log in to iCloud IMAP/SMTP
EV_FROM_EMAIL=business From address used on outgoing mail
EV_BUSINESS_ADDRESSES=comma-separated business addresses the watcher ignores as senders
EV_CAL_SOURCES=comma-separated calendar names copied into the shared calendar
EV_ZELLE_SENDER=sender address of the bank's Zelle alert emails

# --- Pricing shown in the app ---
EV_PRIVACY_OPTIONS=comma-separated privacy package labels, including their prices
EV_OVERTIME_RATE=overtime wording used in the questionnaire, e.g. "<price> per hour"

# --- Supabase (Phase 2+) ---
SUPABASE_URL=project URL (public)
SUPABASE_ANON_KEY=public anon key (safe in a browser; never the service_role key)
# --- Server database login (Phase 4): role ev_server via the transaction pooler ---
EV_BACKEND=json or supabase (default json = today's files)
EV_DB_HOST=pooler host for the project region
EV_DB_PORT=6543
EV_DB_USER=ev_server.<project ref>
EV_DB_PASSWORD=set by scripts/set_server_password.py, never typed by hand
EV_DB_CA=optional path to the Supabase CA certificate (default supabase/supabase-ca.crt)
